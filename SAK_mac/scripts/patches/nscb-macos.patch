diff --git a/py/ztools/lib/sq_settings.py b/py/ztools/lib/sq_settings.py
index 4514479..1a17af6 100644
--- a/py/ztools/lib/sq_settings.py
+++ b/py/ztools/lib/sq_settings.py
@@ -6,6 +6,25 @@ def set_prod_environment():
 	global key_system
 	key_system="production"
 
+def find_keys_file(name=None):
+	# macOS port: portable key lookup shared by Keys.py and NXKeys.py.
+	# Order: $NSCB_KEYS_FILE, <squirrel dir>/<name>, <caller cwd>/<name>, ~/.switch/(prod|dev).keys
+	import os
+	if name is None:
+		name = 'keys.txt' if key_system == 'production' else 'dev_keys.txt'
+	cands = []
+	if os.environ.get('NSCB_KEYS_FILE'):
+		cands.append(os.environ['NSCB_KEYS_FILE'])
+	cands.append(os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), name))
+	cands.append(os.path.join('ztools', name))
+	if os.environ.get('SQUIRREL_ORIG_CWD'):
+		cands.append(os.path.join(os.environ['SQUIRREL_ORIG_CWD'], name))
+	cands.append(os.path.expanduser(os.path.join('~', '.switch', 'prod.keys' if name == 'keys.txt' else 'dev.keys')))
+	for c in cands:
+		if os.path.isfile(c):
+			return c
+	return None
+
 try:
 	a=key_system
