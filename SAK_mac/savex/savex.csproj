<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>savex</AssemblyName>
    <RootNamespace>SaveX</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- LibHac 0.19.0 targets net7.0; it runs fine on newer runtimes. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact pin: LibHac's upstream repo is gone, NuGet is the only source. -->
    <PackageReference Include="LibHac" Version="[0.19.0]" />
  </ItemGroup>

</Project>
